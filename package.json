{
  "name": "provider-plus-front-end",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.6",
    "@mui/material": "7.3.6",
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/dom": "10.4.1",
    "@types/jspdf": "1.3.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "antd": "6.1.3",
    "axios": "^1.20.0",
    "html2canvas": "1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "0.577.0",
    "moment": "2.30.1",
    "qrcode.react": "4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "5.6.0",
    "react-router-dom": "^6.30.6",
    "recharts": "3.6.0",
    "serve": "14.2.6",
    "web-vitals": "2.1.4"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:client": "./e2e/scripts/run-tests.sh --type client",
    "test:e2e:retreat": "./e2e/scripts/run-tests.sh --type retreat",
    "test:e2e:navigation": "./e2e/scripts/run-tests.sh --type navigation",
    "test:e2e:forms": "./e2e/scripts/run-tests.sh --type forms",
    "test:e2e:payments": "./e2e/scripts/run-tests.sh --type payments",
    "test:e2e:mobile": "./e2e/scripts/run-tests.sh --browser mobile",
    "test:e2e:tablet": "./e2e/scripts/run-tests.sh --browser tablet",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node scripts/serve.cjs",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:config": "node scripts/check-vite-config.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.28.0",
    "@babel/preset-typescript": "^7.28.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "babel-jest": "^29.7.0",
    "baseline-browser-mapping": "^2.9.19",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
