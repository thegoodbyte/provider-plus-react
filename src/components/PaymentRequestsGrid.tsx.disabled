import React, { useState, useEffect, useMemo } from 'react';
import { paymentRequestsApi, clientsApi, retreatsApi } from '../services/api';
import { PaymentRequest, Client, Retreat } from '../types';
import LoadingSpinner from './LoadingSpinner';
import ZenDataGrid from './ZenDataGrid';
import { Column } from './ZenDataGrid';
import { IconButton, Chip } from '@mui/material';
import { FiPlus, FiEdit2, FiTrash2, FiEye, FiMail, FiAlertTriangle } from 'react-icons/fi';
import './ClientsGrid.css';

interface PaymentRequestWithDetails extends PaymentRequest {
  clientName?: string;
  retreatName?: string;
}

const PaymentRequestsGrid: React.FC = () => {
  const [paymentRequests, setPaymentRequests] = useState<PaymentRequestWithDetails[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [showAddModal, setShowAddModal] = useState(false);
  const [showEditModal, setShowEditModal] = useState(false);
  const [editingRequest, setEditingRequest] = useState<PaymentRequestWithDetails | null>(null);
  const [clients, setClients] = useState<Client[]>([]);
  const [retreats, setRetreats] = useState<Retreat[]>([]);
  const [formData, setFormData] = useState({
    clientId: '',
    retreatId: '',
    requestedAmount: 0,
    fullPrice: 0,
    currency: 'EUR' as 'CZK' | 'EUR' | 'PLN' | 'USD',
    requestType: 'deposit' as 'deposit' | 'balance' | 'full_payment' | 'additional',
    requestDate: new Date().toISOString().split('T')[0],
    dueDate: '',
    description: '',
    notes: '',
    isUrgent: false
  });
  const [validationErrors, setValidationErrors] = useState<string[]>([]);

  useEffect(() => {
    fetchPaymentRequests();
    fetchClientsAndRetreats();
  }, []);

  const fetchClientsAndRetreats = async () => {
    try {
      const [clientsResponse, retreatsResponse] = await Promise.all([
        clientsApi.getAll(),
        retreatsApi.getAll()
      ]);
      setClients(clientsResponse.data || []);
      setRetreats(retreatsResponse.data || []);
    } catch (error) {
      console.error('Error fetching clients and retreats:', error);
    }
  };

  const fetchPaymentRequests = async () => {
    try {
      setIsLoading(true);
      const response = await paymentRequestsApi.getAll();

      if (!response.data || response.data.length === 0) {
        setPaymentRequests([]);
        return;
      }

      // Get clients and retreats for enrichment
      const [clientsResponse, retreatsResponse] = await Promise.all([
        clientsApi.getAll(),
        retreatsApi.getAll()
      ]);

      const clientsMap = new Map<string, Client>();
      if (clientsResponse.data) {
        clientsResponse.data.forEach((client: Client) =>
          client._id && clientsMap.set(client._id, client)
        );
      }

      const retreatsMap = new Map<string, Retreat>();
      if (retreatsResponse.data) {
        retreatsResponse.data.forEach((retreat: Retreat) =>
          retreat._id && retreatsMap.set(retreat._id, retreat)
        );
      }

      // Enrich payment requests with client and retreat names
      const enrichedRequests = response.data.map((request: PaymentRequest) => {
        const client = clientsMap.get(request.clientId);
        const retreat = retreatsMap.get(request.retreatId);

        return {
          ...request,
          clientName: client ? `${client.firstName} ${client.lastName}` : 'Unknown Client',
          retreatName: retreat?.name || 'Unknown Retreat'
        };
      });

      setPaymentRequests(enrichedRequests);
    } catch (error) {
      console.error('Error fetching payment requests:', error);
      setPaymentRequests([]);
    } finally {
      setIsLoading(false);
    }
  };

  const columns: Column[] = useMemo(() => [
    {
      field: 'clientName',
      headerName: 'Client',
      width: 200,
      sortable: true
    },
    {
      field: 'retreatName',
      headerName: 'Retreat',
      width: 200,
      sortable: true
    },
    {
      field: 'requestedAmount',
      headerName: 'Amount',
      width: 120,
      renderCell: (value, row) => `${value} ${row.currency}`,
      sortable: true,
      type: 'number'
    },
    {
      field: 'requestType',
      headerName: 'Type',
      width: 100,
      renderCell: (value) => {
        const colors: Record<string, 'default' | 'primary' | 'secondary' | 'error' | 'info' | 'success' | 'warning'> = {
          deposit: 'primary',
          balance: 'warning',
          full_payment: 'success',
          additional: 'info'
        };
        return <Chip label={value?.toUpperCase() || 'N/A'} color={colors[value] || 'default'} size="small" />;
      },
      sortable: true
    },
    {
      field: 'status',
      headerName: 'Status',
      width: 100,
      renderCell: (value, row) => {
        let color: 'default' | 'primary' | 'secondary' | 'error' | 'info' | 'success' | 'warning' = 'default';
        switch(value) {
          case 'pending':
            color = 'warning';
            break;
          case 'paid':
            color = 'success';
            break;
          case 'overdue':
            color = 'error';
            break;
          case 'cancelled':
            color = 'default';
            break;
        }
        return (
          <div style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
            <Chip label={value?.toUpperCase() || 'N/A'} color={color} size="small" />
            {row.isUrgent && <FiAlertTriangle color="red" size={14} />}
          </div>
        );
      },
      sortable: true
    },
    {
      field: 'requestDate',
      headerName: 'Request Date',
      width: 120,
      renderCell: (value) => value ? new Date(value).toLocaleDateString() : '',
      sortable: true,
      type: 'date'
    },
    {
      field: 'dueDate',
      headerName: 'Due Date',
      width: 120,
      renderCell: (value) => value ? new Date(value).toLocaleDateString() : '',
      sortable: true,
      type: 'date'
    },
    {
      field: 'remindersSent',
      headerName: 'Reminders',
      width: 100,
      renderCell: (value) => value || 0,
      sortable: true,
      type: 'number'
    },
    {
      field: 'actions',
      headerName: 'Actions',
      width: 200,
      align: 'center',
      sortable: false,
      renderCell: (_, row) => (
        <div style={{ display: 'flex', gap: '4px' }}>
          <IconButton size="small" onClick={(e) => { e.stopPropagation(); handleView(row); }} title="View">
            <FiEye />
          </IconButton>
          <IconButton size="small" onClick={(e) => { e.stopPropagation(); handleEdit(row); }} title="Edit">
            <FiEdit2 />
          </IconButton>
          <IconButton
            size="small"
            onClick={(e) => { e.stopPropagation(); handleSendReminder(row); }}
            title="Send Reminder"
            disabled={row.status === 'paid'}
          >
            <FiMail />
          </IconButton>
          <IconButton
            size="small"
            onClick={(e) => { e.stopPropagation(); handleMarkOverdue(row); }}
            title="Mark Overdue"
            color="warning"
            disabled={row.status === 'paid' || row.status === 'overdue'}
          >
            <FiAlertTriangle />
          </IconButton>
          <IconButton size="small" onClick={(e) => { e.stopPropagation(); handleDelete(row._id!); }} color="error" title="Delete">
            <FiTrash2 />
          </IconButton>
        </div>
      )
    }
  ], []);

  const handleView = (request: PaymentRequestWithDetails) => {
    // TODO: Implement view modal
    console.log('View request:', request);
  };

  const handleEdit = (request: PaymentRequestWithDetails) => {
    setEditingRequest(request);
    setFormData({
      clientId: request.clientId,
      retreatId: request.retreatId,
      requestedAmount: request.requestedAmount,
      fullPrice: request.fullPrice,
      currency: request.currency,
      requestType: request.requestType,
      requestDate: new Date(request.requestDate).toISOString().split('T')[0],
      dueDate: request.dueDate ? new Date(request.dueDate).toISOString().split('T')[0] : '',
      description: request.description || '',
      notes: request.notes || '',
      isUrgent: request.isUrgent || false
    });
    setShowEditModal(true);
  };

  const handleSendReminder = async (request: PaymentRequestWithDetails) => {
    try {
      await paymentRequestsApi.sendReminder(request._id!);
      fetchPaymentRequests(); // Refresh data
    } catch (error) {
      console.error('Error sending reminder:', error);
    }
  };

  const handleMarkOverdue = async (request: PaymentRequestWithDetails) => {
    try {
      await paymentRequestsApi.markAsOverdue(request._id!);
      fetchPaymentRequests(); // Refresh data
    } catch (error) {
      console.error('Error marking as overdue:', error);
    }
  };

  const handleDelete = async (id: string) => {
    if (window.confirm('Are you sure you want to delete this payment request?')) {
      try {
        await paymentRequestsApi.delete(id);
        fetchPaymentRequests();
      } catch (error) {
        console.error('Error deleting payment request:', error);
      }
    }
  };

  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>) => {
    const { name, value, type } = e.target;
    const checked = (e.target as HTMLInputElement).checked;

    setFormData(prev => ({
      ...prev,
      [name]: type === 'checkbox' ? checked : value
    }));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setValidationErrors([]);

    const errors: string[] = [];
    if (!formData.clientId) errors.push('Client is required');
    if (!formData.retreatId) errors.push('Retreat is required');
    if (!formData.requestedAmount || formData.requestedAmount <= 0) errors.push('Requested amount must be greater than 0');
    if (!formData.fullPrice || formData.fullPrice <= 0) errors.push('Full price must be greater than 0');

    if (errors.length > 0) {
      setValidationErrors(errors);
      return;
    }

    try {
      const data = {
        ...formData,
        requestedAmount: Number(formData.requestedAmount),
        fullPrice: Number(formData.fullPrice),
        requestDate: new Date(formData.requestDate).toISOString(),
        dueDate: formData.dueDate ? new Date(formData.dueDate).toISOString() : undefined
      };

      if (editingRequest) {
        await paymentRequestsApi.update(editingRequest._id!, data);
      } else {
        await paymentRequestsApi.create(data);
      }

      setShowAddModal(false);
      setShowEditModal(false);
      setEditingRequest(null);
      setFormData({
        clientId: '',
        retreatId: '',
        requestedAmount: 0,
        fullPrice: 0,
        currency: 'EUR',
        requestType: 'deposit',
        requestDate: new Date().toISOString().split('T')[0],
        dueDate: '',
        description: '',
        notes: '',
        isUrgent: false
      });
      fetchPaymentRequests();
    } catch (error) {
      console.error('Error saving payment request:', error);
      setValidationErrors(['Failed to save payment request. Please try again.']);
    }
  };

  if (isLoading) {
    return <LoadingSpinner />;
  }

  return (
    <div className="content">
      <div className="content-header">
        <div className="header-left">
          <h1>Payment Requests</h1>
          <p>Manage invoice and payment requests sent to clients</p>
        </div>
        <div className="header-actions">
          <button className="btn-primary" onClick={() => setShowAddModal(true)}>
            <FiPlus /> Add Payment Request
          </button>
        </div>
      </div>

      <ZenDataGrid
        data={paymentRequests}
        columns={columns}
        stickyHeader={true}
        maxHeight="75vh"
        showToolbar={false}
      />

      {/* Add/Edit Modal */}
      {(showAddModal || showEditModal) && (
        <div className="modal-overlay">
          <div className="modal large-modal" onClick={(e) => e.stopPropagation()}>
            <div className="modal-header">
              <h3>{editingRequest ? 'Edit Payment Request' : 'Add New Payment Request'}</h3>
              <button className="close-btn" onClick={() => {
                setShowAddModal(false);
                setShowEditModal(false);
                setEditingRequest(null);
              }}>×</button>
            </div>

            {validationErrors.length > 0 && (
              <div className="validation-errors">
                {validationErrors.map((error, index) => (
                  <p key={index} className="error-message">{error}</p>
                ))}
              </div>
            )}

            <form onSubmit={handleSubmit}>
              <div className="form-grid">
                <div className="form-section">
                  <h4>Basic Information</h4>

                  <div className="form-group">
                    <label htmlFor="clientId">Client *:</label>
                    <select
                      id="clientId"
                      name="clientId"
                      value={formData.clientId}
                      onChange={handleInputChange}
                      required
                    >
                      <option value="">Select Client...</option>
                      {clients.map(client => (
                        <option key={client._id} value={client._id}>
                          {client.firstName} {client.lastName}
                        </option>
                      ))}
                    </select>
                  </div>

                  <div className="form-group">
                    <label htmlFor="retreatId">Retreat *:</label>
                    <select
                      id="retreatId"
                      name="retreatId"
                      value={formData.retreatId}
                      onChange={handleInputChange}
                      required
                    >
                      <option value="">Select Retreat...</option>
                      {retreats.map(retreat => (
                        <option key={retreat._id} value={retreat._id}>
                          {retreat.name}
                        </option>
                      ))}
                    </select>
                  </div>

                  <div className="form-group">
                    <label htmlFor="requestType">Request Type *:</label>
                    <select
                      id="requestType"
                      name="requestType"
                      value={formData.requestType}
                      onChange={handleInputChange}
                      required
                    >
                      <option value="deposit">Deposit</option>
                      <option value="balance">Balance Payment</option>
                      <option value="full_payment">Full Payment</option>
                      <option value="additional">Additional Payment</option>
                    </select>
                  </div>

                  <div className="form-group">
                    <label htmlFor="requestedAmount">Requested Amount *:</label>
                    <input
                      type="number"
                      id="requestedAmount"
                      name="requestedAmount"
                      value={formData.requestedAmount}
                      onChange={handleInputChange}
                      min="0"
                      step="0.01"
                      required
                    />
                  </div>

                  <div className="form-group">
                    <label htmlFor="fullPrice">Full Price *:</label>
                    <input
                      type="number"
                      id="fullPrice"
                      name="fullPrice"
                      value={formData.fullPrice}
                      onChange={handleInputChange}
                      min="0"
                      step="0.01"
                      required
                    />
                  </div>

                  <div className="form-group">
                    <label htmlFor="currency">Currency *:</label>
                    <select
                      id="currency"
                      name="currency"
                      value={formData.currency}
                      onChange={handleInputChange}
                      required
                    >
                      <option value="EUR">EUR</option>
                      <option value="USD">USD</option>
                      <option value="CZK">CZK</option>
                      <option value="PLN">PLN</option>
                    </select>
                  </div>
                </div>

                <div className="form-section">
                  <h4>Dates & Details</h4>

                  <div className="form-group">
                    <label htmlFor="requestDate">Request Date *:</label>
                    <input
                      type="date"
                      id="requestDate"
                      name="requestDate"
                      value={formData.requestDate}
                      onChange={handleInputChange}
                      required
                    />
                  </div>

                  <div className="form-group">
                    <label htmlFor="dueDate">Due Date:</label>
                    <input
                      type="date"
                      id="dueDate"
                      name="dueDate"
                      value={formData.dueDate}
                      onChange={handleInputChange}
                    />
                  </div>

                  <div className="form-group">
                    <label htmlFor="description">Description:</label>
                    <input
                      type="text"
                      id="description"
                      name="description"
                      value={formData.description}
                      onChange={handleInputChange}
                      placeholder="Brief description of the payment request"
                    />
                  </div>

                  <div className="form-group">
                    <label htmlFor="notes">Internal Notes:</label>
                    <textarea
                      id="notes"
                      name="notes"
                      value={formData.notes}
                      onChange={handleInputChange}
                      rows={3}
                      placeholder="Internal notes (not visible to client)"
                    />
                  </div>

                  <div className="form-group">
                    <label>
                      <input
                        type="checkbox"
                        name="isUrgent"
                        checked={formData.isUrgent}
                        onChange={handleInputChange}
                      />
                      Mark as urgent
                    </label>
                  </div>
                </div>
              </div>

              <div className="modal-actions">
                <button type="button" onClick={() => {
                  setShowAddModal(false);
                  setShowEditModal(false);
                  setEditingRequest(null);
                }}>
                  Cancel
                </button>
                <button type="submit" className="primary-btn">
                  {editingRequest ? 'Update' : 'Create'} Payment Request
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};

export default PaymentRequestsGrid;