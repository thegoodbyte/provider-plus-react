                                  const meds = [...(formData.currentMedications?.medications || [])];
                                  meds[index] = { ...meds[index], since: e.target.value };
                                  setFormData(prev => ({
                                    ...prev,
                                    currentMedications: {
                                      ...prev.currentMedications,
                                      medications: meds
                                    }
                                  }));
                                }}
                                style={{ padding: '5px', fontSize: '12px' }}
                              />
                              <input
                                type="text"
                                placeholder="Mg Daily (e.g., 50mg)"
