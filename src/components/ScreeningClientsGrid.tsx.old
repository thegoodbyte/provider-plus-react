                            heartConditions: e.target.checked
                              ? { ok: true, na: false, details: '' }
                              : typeof prev.heartConditions === 'object'
                                ? { ...prev.heartConditions, ok: false }
                                : { ok: false, na: false, details: prev.heartConditions || '' }
                          }))}
