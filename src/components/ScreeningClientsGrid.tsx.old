                                }}
                                style={{ padding: '5px', fontSize: '12px' }}
                              />
                            </div>
                            <input
                              type="text"
                              placeholder="Reason for taking"
                              value={med.reason}
                              onChange={(e) => {
                                const meds = [...(formData.currentMedications?.medications || [])];
                                meds[index] = { ...meds[index], reason: e.target.value };
                                setFormData(prev => ({
                                  ...prev,
                                  currentMedications: {
                                    ...prev.currentMedications,
                                    medications: meds
                                  }
                                }));
                              }}
