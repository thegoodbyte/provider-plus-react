                        {(formData.currentMedications?.medications || []).map((med, index) => (
                          <div key={index} style={{ marginBottom: '15px', padding: '10px', backgroundColor: 'white', borderRadius: '4px', border: '1px solid #e1e1e1' }}>
                            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px' }}>
                              <input
                                type="text"
                                placeholder="Medication Name"
                                value={med.name}
                                onChange={(e) => {
                                  const meds = [...(formData.currentMedications?.medications || [])];
                                  meds[index] = { ...meds[index], name: e.target.value };
                                  setFormData(prev => ({
                                    ...prev,
                                    currentMedications: {
                                      ...prev.currentMedications,
                                      medications: meds
                                    }
                                  }));
                                }}
