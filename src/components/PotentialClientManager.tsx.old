import React, { useState, useEffect } from 'react';
import AppleButton from './AppleButton';
import AppleInput from './AppleInput';
import { clientsApi } from '../services/api';
import { Client } from '../types';

const PotentialClientManager: React.FC = () => {
  const [potentialClients, setPotentialClients] = useState<Client[]>([]);
  const [existingClients, setExistingClients] = useState<Client[]>([]);
  const [selectedClient, setSelectedClient] = useState<Client | null>(null);
  const [selectedExistingClient, setSelectedExistingClient] = useState<string>('');
  const [showForm, setShowForm] = useState(false);
  const [showConvertModal, setShowConvertModal] = useState(false);
  const [formData, setFormData] = useState<Partial<Client>>({
    firstName: '',
    lastName: '',
    phone: '',
    phoneCountryCode: '+420',
    email: '',
    country: '',
    address: '',
    workflowStatus: 'potential',
    priority: 'medium',
    whySeekingIboga: '',
    whatToChange: '',
    previousPlantMedicines: '',
    mentalHealthHistory: '',
    currentMedications: '',
    vitaminsSupplements: '',
    firstContactDate: new Date(),
    status: 'active'
  });

  // Generate unique screening ID
  const generateScreeningId = () => {
    const timestamp = Date.now();
    const random = Math.floor(Math.random() * 1000);
    return `ISCZ-P-${timestamp.toString().slice(-4)}${random.toString().padStart(3, '0')}`;
  };

  // Fetch potential clients
  const fetchPotentialClients = async () => {
    try {
      const response = await clientsApi.getPotential();
      setPotentialClients(response.data || []);
    } catch (error) {
      console.error('Error fetching potential clients:', error);
    }
  };

  // Fetch existing clients
  const fetchExistingClients = async () => {
    try {
      const response = await clientsApi.getAll();
      setExistingClients(response.data || []);
    } catch (error) {
      console.error('Error fetching existing clients:', error);
    }
  };

  useEffect(() => {
    fetchPotentialClients();
    fetchExistingClients();
  }, []);

  // Handle existing client selection
  const handleExistingClientSelect = (clientId: string) => {
    setSelectedExistingClient(clientId);
    if (clientId) {
      const client = existingClients.find(c => c._id === clientId);
      if (client) {
        setSelectedClient(null);
        setFormData({
          firstName: client.firstName,
          lastName: client.lastName,
          phone: client.phone,
          phoneCountryCode: '+420',
          email: client.email || '',
          country: client.country || '',
          workflowStatus: 'potential',
          whySeekingIboga: '',
          whatToChange: '',
          previousPlantMedicines: '',
          mentalHealthHistory: '',
          currentMedications: '',
          vitaminsSupplements: '',
          firstContactDate: new Date(),
          status: 'active'
        });
      }
    }
  };

  // Add new potential client
  const handleAddPotentialClient = () => {
    setSelectedClient(null);
    setSelectedExistingClient('');
    setFormData({
      firstName: '',
      lastName: '',
      phone: '',
      phoneCountryCode: '+420',
      email: '',
      country: '',
      address: '',
      workflowStatus: 'potential',
      whySeekingIboga: '',
      whatToChange: '',
      previousPlantMedicines: '',
      mentalHealthHistory: '',
      currentMedications: {
        ssri: false,
        antidepressants: false,
        other: false,
        otherDetails: ''
      },
      vitaminsSupplements: {
        vitaminD: false,
        vitaminB12: false,
        vitaminC: false,
        omega3: false,
        magnesium: false,
        probiotics: false,
        multivitamin: false,
        other: false,
        otherDetails: ''
      },
      firstContactDate: new Date()
    });
    setShowForm(true);
  };

  // Save potential client
  const handleSave = async () => {
    // Validate required fields
    if (!formData.firstName?.trim()) {
      alert('First name is required');
      return;
    }
    if (!formData.lastName?.trim()) {
      alert('Last name is required');
      return;
    }
    if (!formData.phone?.trim()) {
      alert('Phone is required');
      return;
    }
    if (!formData.country?.trim()) {
      alert('Country is required');
      return;
    }
    if (!formData.whySeekingIboga?.trim()) {
      alert('Why seeking iboga is required');
      return;
    }
    if (!formData.whatToChange?.trim()) {
      alert('What to change is required');
      return;
    }

    try {
      if (selectedClient?._id) {
        await clientsApi.update(selectedClient._id, {
          ...formData,
          phone: formData.phone?.trim() || ''
        });
      } else {
        await clientsApi.quickAdd({
          ...formData,
          firstName: formData.firstName.trim(),
          lastName: formData.lastName.trim(),
          phone: formData.phone?.trim() || '',
          country: formData.country.trim(),
          firstContactDate: formData.firstContactDate || new Date(),
          whySeekingIboga: formData.whySeekingIboga.trim(),
          whatToChange: formData.whatToChange.trim(),
          workflowStatus: 'potential'
        });
      }
      fetchPotentialClients();
      setShowForm(false);
      setSelectedClient(null);
      setSelectedExistingClient('');
      setFormData({
        firstName: '',
        lastName: '',
        phone: '',
        phoneCountryCode: '+420',
        email: '',
        country: '',
        address: '',
        workflowStatus: 'potential',
        whySeekingIboga: '',
        whatToChange: '',
        previousPlantMedicines: '',
        mentalHealthHistory: '',
        currentMedications: '',
        vitaminsSupplements: '',
        firstContactDate: new Date()
      });
    } catch (error) {
      console.error('Error saving potential client:', error);
      alert('Error saving potential client. Please try again.');
    }
  };

  // Convert to actual client
  const handleConvertToClient = async (potentialClient: Client) => {
    setSelectedClient(potentialClient);
    setShowConvertModal(true);
  };

  const confirmConversion = async () => {
    if (!selectedClient) return;

    try {
      // Create new client with all screening data
      const newClientData = {
        firstName: selectedClient.firstName,
        lastName: selectedClient.lastName,
        phone: selectedClient.phone,
        email: selectedClient.email || '',
        country: selectedClient.country,
        address: selectedClient.country || '', // Required field for Client
        medicalConditions: selectedClient.otherMedicalComplications,
        notes: `Converted from screening client ${selectedClient.screeningId || selectedClient._id}\n\nWhy Seeking Iboga:\n${selectedClient.whySeekingIboga}\n\nWhat to Change:\n${selectedClient.whatToChange}`
      };

      const response = await clientsApi.create(newClientData);

      // Update potential client status and link
      await screeningClientsApi.update(selectedClient._id!, {
        status: 'converted',
        convertedToClientId: response.data._id
      });

      fetchPotentialClients();
      setShowConvertModal(false);
      setSelectedClient(null);
    } catch (error) {
      console.error('Error converting to client:', error);
    }
  };

  // Cancel form
  const handleCancel = () => {
    setShowForm(false);
    setSelectedClient(null);
    setSelectedExistingClient('');
    setFormData({
      firstName: '',
      lastName: '',
      phone: '',
      phoneCountryCode: '+420',
      email: '',
      country: '',
      age: undefined,
      workflowStatus: 'potential',
      whySeekingIboga: '',
      whatToChange: '',
      previousPlantMedicines: {
        ayahuasca: false,
        marijuana: false,
        psilocybin: false,
        other: false,
        otherDetails: ''
      },
      mentalHealthHistory: '',
      currentMedications: {
        ssri: false,
        antidepressants: false,
        other: false,
        otherDetails: ''
      },
      vitaminsSupplements: {
        vitaminD: false,
        vitaminB12: false,
        vitaminC: false,
        omega3: false,
        magnesium: false,
        probiotics: false,
        multivitamin: false,
        other: false,
        otherDetails: ''
      },
      firstContactDate: new Date()
    });
  };

  // Add notes to client
  const handleAddNotes = async (clientId: string, notes: string) => {
    const client = potentialClients.find(c => c._id === clientId);
    if (client) {
      const updated = {
        ...client,
        notes: `${client.notes || ''}\n${new Date().toISOString()}: ${notes}`,
        lastContactDate: new Date()
      };
      await screeningClientsApi.update(clientId, updated);
      fetchPotentialClients();
    }
  };


  return (
    <div style={{ padding: '24px' }}>
      {/* Page Header */}
      <div style={{ marginBottom: '24px' }}>
        <h1 style={{ fontSize: '24px', fontWeight: '600', color: '#1f2937', margin: 0 }}>🎯 Potential Clients</h1>
        <p style={{ fontSize: '14px', color: '#6b7280', marginTop: '4px' }}>
          Manage screening calls and convert qualified leads to clients
        </p>
      </div>

      {/* Toolbar */}
      <div style={{
        display: 'flex',
        gap: '12px',
        alignItems: 'center',
        padding: '12px 16px',
        backgroundColor: '#f9fafb',
        borderRadius: '8px',
        border: '1px solid #e5e7eb',
        marginBottom: '24px'
      }}>
        {/* Client Selector */}
        <div className="flex items-center gap-3">
          <label className="text-sm font-medium text-apple-gray-700">Client:</label>
          <select
            value={selectedExistingClient}
            onChange={(e) => {
              if (e.target.value === 'new') {
                handleAddPotentialClient();
              } else {
                handleExistingClientSelect(e.target.value);
                if (e.target.value) {
                  setShowForm(true);
                }
              }
            }}
            className="px-4 py-2 border border-apple-gray-200 rounded-apple focus:outline-none focus:ring-2 focus:ring-apple-blue/20 bg-white"
          >
            <option value="">Choose an option...</option>
            <option value="new">➕ Create New Screening Client</option>
            {existingClients.map((client) => (
              <option key={client._id} value={client._id}>
                {client.firstName} {client.lastName} ({client.email})
              </option>
            ))}
          </select>
        </div>

        {/* Spacer */}
        <div style={{ flex: 1 }} />

        {/* Action Buttons */}
        <div className="flex items-center gap-2">
          <button
            onClick={handleAddPotentialClient}
            className="px-4 py-2 bg-apple-blue text-white rounded-apple hover:bg-apple-blue-dark transition-colors"
          >
            ➕ New Screening
          </button>
        </div>
      </div>


      {/* Potential Clients Grid */}
      <div className="bg-white rounded-apple-lg shadow-apple overflow-hidden">
        <div className="overflow-x-auto">
          <table className="min-w-full">
          <thead>
            <tr className="bg-apple-gray-50 border-b border-apple-gray-200">
              <th className="px-6 py-3 text-left text-xs font-medium text-apple-gray-500 uppercase tracking-wider">
                ID
              </th>
              <th className="px-6 py-3 text-left text-xs font-medium text-apple-gray-500 uppercase tracking-wider">
                Name
              </th>
              <th className="px-6 py-3 text-left text-xs font-medium text-apple-gray-500 uppercase tracking-wider">
                Contact
              </th>
              <th className="px-6 py-3 text-left text-xs font-medium text-apple-gray-500 uppercase tracking-wider">
                Last Contact
              </th>
              <th className="px-6 py-3 text-left text-xs font-medium text-apple-gray-500 uppercase tracking-wider">
                Actions
              </th>
            </tr>
          </thead>
          <tbody className="bg-white divide-y divide-apple-gray-200">
            {potentialClients.map((client) => (
              <tr key={client._id} className="hover:bg-apple-gray-50 transition-colors">
                <td className="px-6 py-4 whitespace-nowrap text-sm font-mono text-apple-blue">
                  {client.screeningId || `ID-${client._id?.slice(-6) || 'NEW'}`}
                </td>
                <td className="px-6 py-4 whitespace-nowrap">
                  <div>
                    <div className="text-sm font-medium text-apple-gray-900">
                      {client.firstName} {client.lastName || ''}
                    </div>
                    <div className="text-xs text-apple-gray-500">
                      {client.country}
                    </div>
                  </div>
                </td>
                <td className="px-6 py-4 whitespace-nowrap">
                  <div className="text-sm text-apple-gray-900">{client.phone}</div>
                  <div className="text-xs text-apple-gray-500">{client.email}</div>
                </td>
                <td className="px-6 py-4 whitespace-nowrap text-sm text-apple-gray-500">
                  {client.firstContactDate
                    ? new Date(client.firstContactDate).toLocaleDateString()
                    : 'Unknown'}
                </td>
                <td className="px-6 py-4 whitespace-nowrap text-sm">
                  <div className="flex gap-2">
                    <button
                      onClick={() => handleAddNotes(client._id!, 'Follow-up call completed')}
                      className="text-apple-blue hover:text-blue-700"
                    >
                      Add Note
                    </button>
                    {client.status === 'approved' && (
                      <button
                        onClick={() => handleConvertToClient(client)}
                        className="text-apple-green hover:text-green-700 font-medium"
                      >
                        Convert
                      </button>
                    )}
                    <button
                      onClick={() => {
                        setSelectedClient(client);
                        // Parse existing phone number to separate country code and number
                        const parsePhone = (phone: string) => {
                          if (!phone) return { phoneCountryCode: '+420', phoneNumber: '' };
                          const countryPrefixes = ['+420', '+48', '+1', '+44', '+49', '+33', '+34', '+39', '+31', '+43', '+41', '+32', '+421', '+36', '+386', '+385', '+61', '+64'];
                          const foundPrefix = countryPrefixes.find(prefix => phone.startsWith(prefix));
                          if (foundPrefix) {
                            return {
                              phoneCountryCode: foundPrefix,
                              phoneNumber: phone.substring(foundPrefix.length).trim()
                            };
                          }
                          return { phoneCountryCode: '+420', phoneNumber: phone };
                        };
                        const { countryCode, phoneNumber } = parsePhone(client.phone || '');
                        setFormData({
                          ...client,
                          countryCode,
                          phone: phoneNumber
                        });
                        setShowForm(true);
                      }}
                      className="text-apple-gray-600 hover:text-apple-gray-900"
                    >
                      Edit
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        </div>
      </div>

      {/* Add/Edit Form Modal */}
      {showForm && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
          <div className="fixed inset-0 bg-black/30 backdrop-blur-sm" />
          <div className="relative bg-white rounded-apple-xl shadow-apple-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <div className="p-6">
              <h2 className="text-xl font-semibold text-apple-gray-900 mb-4">
                {selectedClient ? 'Edit' : 'Add'} Potential Client
              </h2>

              <div className="space-y-4">
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <AppleInput
                    label="First Name"
                    value={formData.firstName || ''}
                    onChange={(value) => setFormData({ ...formData, firstName: value })}
                    required
                  />
                  <AppleInput
                    label="Last Name"
                    value={formData.lastName || ''}
                    onChange={(value) => setFormData({ ...formData, lastName: value })}
                    required
                  />
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-sm font-medium text-apple-gray-700 mb-1">Phone *</label>
                    <div className="flex">
                      <select
                        className="px-3 py-2 border border-r-0 border-apple-gray-200 rounded-l-apple focus:outline-none focus:ring-2 focus:ring-apple-blue/20 bg-white text-sm"
                        value={formData.countryCode || '+420'}
                        onChange={(e) => setFormData({ ...formData, phoneCountryCode: e.target.value })}
                      >
                        <option value="+420">🇨🇿 +420</option>
                        <option value="+48">🇵🇱 +48</option>
                        <option value="+1">🇺🇸 +1</option>
                        <option value="+1">🇨🇦 +1</option>
                        <option value="+44">🇬🇧 +44</option>
                        <option value="+49">🇩🇪 +49</option>
                        <option value="+33">🇫🇷 +33</option>
                        <option value="+34">🇪🇸 +34</option>
                        <option value="+39">🇮🇹 +39</option>
                        <option value="+31">🇳🇱 +31</option>
                        <option value="+43">🇦🇹 +43</option>
                        <option value="+41">🇨🇭 +41</option>
                        <option value="+32">🇧🇪 +32</option>
                        <option value="+421">🇸🇰 +421</option>
                        <option value="+36">🇭🇺 +36</option>
                        <option value="+386">🇸🇮 +386</option>
                        <option value="+385">🇭🇷 +385</option>
                        <option value="+61">🇦🇺 +61</option>
                        <option value="+64">🇳🇿 +64</option>
                      </select>
                      <input
                        type="tel"
                        value={formData.phone || ''}
                        onChange={(e) => setFormData({ ...formData, phone: e.target.value })}
                        className="flex-1 px-4 py-2 border border-apple-gray-200 rounded-r-apple focus:outline-none focus:ring-2 focus:ring-apple-blue/20"
                        placeholder="123 456 789"
                        required
                      />
                    </div>
                  </div>
                  <AppleInput
                    label="Email"
                    value={formData.email || ''}
                    onChange={(value) => setFormData({ ...formData, email: value })}
                    type="email"
                  />
                </div>

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <AppleInput
                    label="Age"
                    value={formData.age?.toString() || ''}
                    onChange={(value) => setFormData({ ...formData, age: value ? parseInt(value) : undefined })}
                    type="number"
                    min="18"
                    max="120"
                  />
                  <div>
                    <label className="block text-sm font-medium text-apple-gray-700 mb-1">Country *</label>
                    <select
                      value={formData.country || ''}
                      onChange={(e) => setFormData({ ...formData, country: e.target.value })}
                      className="w-full px-4 py-2 border border-apple-gray-200 rounded-apple focus:outline-none focus:ring-2 focus:ring-apple-blue/20"
                      required
                    >
                      <option value="">Select a country</option>
                      <option value="Czech Republic">Czech Republic</option>
                      <option value="Poland">Poland</option>
                      <option value="">---</option>
                      <option value="USA">United States</option>
                      <option value="Canada">Canada</option>
                      <option value="UK">United Kingdom</option>
                      <option value="Germany">Germany</option>
                      <option value="France">France</option>
                      <option value="Spain">Spain</option>
                      <option value="Italy">Italy</option>
                      <option value="Netherlands">Netherlands</option>
                      <option value="Austria">Austria</option>
                      <option value="Switzerland">Switzerland</option>
                      <option value="Belgium">Belgium</option>
                      <option value="Slovakia">Slovakia</option>
                      <option value="Hungary">Hungary</option>
                      <option value="Slovenia">Slovenia</option>
                      <option value="Croatia">Croatia</option>
                      <option value="Australia">Australia</option>
                      <option value="New Zealand">New Zealand</option>
                      <option value="Other">Other</option>
                    </select>
                  </div>
                </div>

                <div>
                  <AppleInput
                    label="Screening ID (ISCZ-P)"
                    value={formData.screeningId || ''}
                    onChange={(value) => setFormData({ ...formData, screeningId: value })}
                    placeholder="Auto-generated if empty"
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-apple-gray-700 mb-1">Status</label>
                  <select
                    value={formData.status}
                    onChange={(e) => setFormData({ ...formData, status: e.target.value as any })}
                    className="w-full px-4 py-2 border border-apple-gray-200 rounded-apple focus:outline-none focus:ring-2 focus:ring-apple-blue/20"
                  >
                    <option value="initial">Initial</option>
                    <option value="in_progress">In Progress</option>
                    <option value="completed">Completed</option>
                    <option value="approved">Approved</option>
                    <option value="rejected">Rejected</option>
                  </select>
                </div>

                <div>
                  <label className="block text-sm font-medium text-apple-gray-700 mb-1">Why Seeking Iboga?</label>
                  <textarea
                    value={formData.whySeekingIboga || ''}
                    onChange={(e) => setFormData({ ...formData, whySeekingIboga: e.target.value })}
                    rows={3}
                    className="w-full px-4 py-2 border border-apple-gray-200 rounded-apple focus:outline-none focus:ring-2 focus:ring-apple-blue/20"
                    placeholder="Describe their motivation for seeking iboga treatment..."
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-apple-gray-700 mb-1">What Do They Want to Change?</label>
                  <textarea
                    value={formData.whatToChange || ''}
                    onChange={(e) => setFormData({ ...formData, whatToChange: e.target.value })}
                    rows={3}
                    className="w-full px-4 py-2 border border-apple-gray-200 rounded-apple focus:outline-none focus:ring-2 focus:ring-apple-blue/20"
                    placeholder="What aspects of their life are they looking to transform..."
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-apple-gray-700 mb-3">Previous Plant Medicines</label>
                  <div className="space-y-3">
                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                      <label className="flex items-center gap-2">
                        <input
                          type="checkbox"
                          checked={formData.previousPlantMedicines?.ayahuasca || false}
                          onChange={(e) => setFormData({
                            ...formData,
                            previousPlantMedicines: {
                              ...formData.previousPlantMedicines,
                              ayahuasca: e.target.checked
                            }
                          })}
                          className="rounded border-apple-gray-300 text-apple-blue focus:ring-apple-blue/20"
                        />
                        <span className="text-sm text-apple-gray-700">Ayahuasca</span>
                      </label>

                      <label className="flex items-center gap-2">
                        <input
                          type="checkbox"
                          checked={formData.previousPlantMedicines?.marijuana || false}
                          onChange={(e) => setFormData({
                            ...formData,
                            previousPlantMedicines: {
                              ...formData.previousPlantMedicines,
                              marijuana: e.target.checked
                            }
                          })}
                          className="rounded border-apple-gray-300 text-apple-blue focus:ring-apple-blue/20"
                        />
                        <span className="text-sm text-apple-gray-700">Marijuana</span>
                      </label>

                      <label className="flex items-center gap-2">
                        <input
                          type="checkbox"
                          checked={formData.previousPlantMedicines?.psilocybin || false}
                          onChange={(e) => setFormData({
                            ...formData,
                            previousPlantMedicines: {
                              ...formData.previousPlantMedicines,
                              psilocybin: e.target.checked
                            }
                          })}
                          className="rounded border-apple-gray-300 text-apple-blue focus:ring-apple-blue/20"
                        />
                        <span className="text-sm text-apple-gray-700">Psilocybin</span>
                      </label>

                      <label className="flex items-center gap-2">
                        <input
                          type="checkbox"
                          checked={formData.previousPlantMedicines?.other || false}
                          onChange={(e) => setFormData({
                            ...formData,
                            previousPlantMedicines: {
                              ...formData.previousPlantMedicines,
                              other: e.target.checked
                            }
                          })}
                          className="rounded border-apple-gray-300 text-apple-blue focus:ring-apple-blue/20"
                        />
                        <span className="text-sm text-apple-gray-700">Other</span>
                      </label>
                    </div>

                    {formData.previousPlantMedicines?.other && (
                      <div>
                        <input
                          type="text"
                          value={formData.previousPlantMedicines?.otherDetails || ''}
                          onChange={(e) => setFormData({
                            ...formData,
                            previousPlantMedicines: {
                              ...formData.previousPlantMedicines,
                              otherDetails: e.target.value
                            }
                          })}
                          placeholder="Please specify other plant medicines..."
                          className="w-full px-4 py-2 border border-apple-gray-200 rounded-apple focus:outline-none focus:ring-2 focus:ring-apple-blue/20"
                        />
                      </div>
                    )}
                  </div>
                </div>

                <div>
                  <label className="block text-sm font-medium text-apple-gray-700 mb-1">Mental Health History</label>
                  <textarea
                    value={formData.mentalHealthHistory || ''}
                    onChange={(e) => setFormData({ ...formData, mentalHealthHistory: e.target.value })}
                    rows={2}
                    className="w-full px-4 py-2 border border-apple-gray-200 rounded-apple focus:outline-none focus:ring-2 focus:ring-apple-blue/20"
                    placeholder="Any history of depression, anxiety, or other mental health conditions..."
                  />
                </div>

                <div>
                  <label className="block text-sm font-medium text-apple-gray-700 mb-2">Current Medications</label>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.currentMedications?.ssri || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          currentMedications: {
                            ...formData.currentMedications,
                            ssri: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">SSRI</span>
                    </label>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.currentMedications?.antidepressants || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          currentMedications: {
                            ...formData.currentMedications,
                            antidepressants: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Antidepressants</span>
                    </label>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.currentMedications?.other || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          currentMedications: {
                            ...formData.currentMedications,
                            other: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Other</span>
                    </label>
                  </div>
                  {formData.currentMedications?.other && (
                    <AppleInput
                      placeholder="Please specify other medications"
                      value={formData.currentMedications?.otherDetails || ''}
                      onChange={(value) => setFormData({
                        ...formData,
                        currentMedications: {
                          ...formData.currentMedications,
                          otherDetails: value
                        }
                      })}
                    />
                  )}
                </div>

                <div>
                  <label className="block text-sm font-medium text-apple-gray-700 mb-2">Vitamins & Supplements</label>
                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.vitaminsSupplements?.vitaminD || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          vitaminsSupplements: {
                            ...formData.vitaminsSupplements,
                            vitaminD: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Vitamin D</span>
                    </label>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.vitaminsSupplements?.vitaminB12 || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          vitaminsSupplements: {
                            ...formData.vitaminsSupplements,
                            vitaminB12: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Vitamin B12</span>
                    </label>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.vitaminsSupplements?.vitaminC || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          vitaminsSupplements: {
                            ...formData.vitaminsSupplements,
                            vitaminC: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Vitamin C</span>
                    </label>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.vitaminsSupplements?.omega3 || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          vitaminsSupplements: {
                            ...formData.vitaminsSupplements,
                            omega3: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Omega-3</span>
                    </label>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.vitaminsSupplements?.magnesium || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          vitaminsSupplements: {
                            ...formData.vitaminsSupplements,
                            magnesium: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Magnesium</span>
                    </label>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.vitaminsSupplements?.probiotics || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          vitaminsSupplements: {
                            ...formData.vitaminsSupplements,
                            probiotics: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Probiotics</span>
                    </label>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.vitaminsSupplements?.multivitamin || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          vitaminsSupplements: {
                            ...formData.vitaminsSupplements,
                            multivitamin: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Multivitamin</span>
                    </label>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.vitaminsSupplements?.kratom || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          vitaminsSupplements: {
                            ...formData.vitaminsSupplements,
                            kratom: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Kratom</span>
                    </label>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.vitaminsSupplements?.creatine || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          vitaminsSupplements: {
                            ...formData.vitaminsSupplements,
                            creatine: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Creatine</span>
                    </label>
                    <label className="flex items-center gap-2 cursor-pointer">
                      <input
                        type="checkbox"
                        checked={formData.vitaminsSupplements?.other || false}
                        onChange={(e) => setFormData({
                          ...formData,
                          vitaminsSupplements: {
                            ...formData.vitaminsSupplements,
                            other: e.target.checked
                          }
                        })}
                        className="w-4 h-4 text-apple-blue rounded border-apple-gray-300 focus:ring-apple-blue/20"
                      />
                      <span className="text-sm text-apple-gray-700">Other</span>
                    </label>
                  </div>
                  {formData.vitaminsSupplements?.other && (
                    <AppleInput
                      placeholder="Please specify other vitamins/supplements"
                      value={formData.vitaminsSupplements?.otherDetails || ''}
                      onChange={(value) => setFormData({
                        ...formData,
                        vitaminsSupplements: {
                          ...formData.vitaminsSupplements,
                          otherDetails: value
                        }
                      })}
                    />
                  )}
                </div>

                <div>
                  <label className="block text-sm font-medium text-apple-gray-700 mb-1">Additional Notes</label>
                  <textarea
                    value={formData.notes || ''}
                    onChange={(e) => setFormData({ ...formData, notes: e.target.value })}
                    rows={2}
                    className="w-full px-4 py-2 border border-apple-gray-200 rounded-apple focus:outline-none focus:ring-2 focus:ring-apple-blue/20"
                    placeholder="Any other relevant information from the screening call..."
                  />
                </div>
              </div>

              <div className="mt-6 flex justify-end gap-3">
                <AppleButton variant="ghost" onClick={handleCancel}>
                  Cancel
                </AppleButton>
                <AppleButton onClick={handleSave}>
                  Save
                </AppleButton>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* Convert to Client Modal */}
      {showConvertModal && selectedClient && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4">
          <div className="fixed inset-0 bg-black/30 backdrop-blur-sm" onClick={() => setShowConvertModal(false)} />
          <div className="relative bg-white rounded-apple-xl shadow-apple-xl max-w-md w-full">
            <div className="p-6">
              <h2 className="text-xl font-semibold text-apple-gray-900 mb-4">
                Convert to Client
              </h2>
              <p className="text-sm text-apple-gray-600 mb-6">
                Are you sure you want to convert <strong>{selectedClient.firstName} {selectedClient.lastName || ''}</strong>
                ({selectedClient.screeningId || selectedClient._id}) to an actual client? All screening data will be transferred.
              </p>

              <div className="bg-apple-gray-50 rounded-apple p-4 mb-6">
                <h3 className="text-sm font-medium text-apple-gray-700 mb-2">Data to be transferred:</h3>
                <ul className="text-xs text-apple-gray-600 space-y-1">
                  <li>✓ Personal information</li>
                  <li>✓ Medical history</li>
                  <li>✓ Screening notes</li>
                  <li>✓ Communication history</li>
                </ul>
              </div>

              <div className="flex justify-end gap-3">
                <AppleButton variant="ghost" onClick={() => setShowConvertModal(false)}>
                  Cancel
                </AppleButton>
                <AppleButton onClick={confirmConversion}>
                  Convert to Client
                </AppleButton>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};

export default PotentialClientManager;