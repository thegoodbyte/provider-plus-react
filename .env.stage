# Staging Environment for Provider Plus Frontend
REACT_APP_ENV=staging
REACT_APP_API_URL=https://api-stage.ibogaspirit.net
REACT_APP_PUBLIC_URL=https://stage.ibogaspirit.net

# Feature Flags
REACT_APP_ENABLE_DEBUG=true
REACT_APP_ENABLE_ANALYTICS=false

# Version (automatically set from package.json)
REACT_APP_VERSION=$npm_package_version

# Optional: Google Analytics (for staging testing)
REACT_APP_GA_TRACKING_ID=UA-STAGING-ID

# Optional: Sentry Error Tracking (staging project)
REACT_APP_SENTRY_DSN=https://staging-key@sentry.io/project-id

# Staging Server
REACT_APP_FRONTEND_HOST=159.223.122.27
