FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .

# File-watching under Docker Desktop's virtualized filesystem needs polling,
# otherwise CRA's dev-server hot reload silently stops working.
ENV CHOKIDAR_USEPOLLING=true
ENV WDS_SOCKET_PORT=0

EXPOSE 3000
CMD ["npm", "start"]
